# Chaves de API para os Provedores LLM suportados no Oráculo RAG
# Renomeie este arquivo para .env e preencha as variáveis abaixo de acordo com o provedor que deseja utilizar.

# Provedor Google Gemini (Google Generative AI)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=seu_api_key_do_gemini_aqui

# Provedor OpenAI (GPT models)
# Obtenha em: https://platform.openai.com/
OPENAI_API_KEY=seu_api_key_da_openai_aqui

# Provedor OpenRouter (OpenRouter API)
# Obtenha em: https://openrouter.ai/
OPENROUTER_API_KEY=seu_api_key_do_openrouter_aqui
